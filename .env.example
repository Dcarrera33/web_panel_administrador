# Copia este archivo como ".env" y rellena los valores. NUNCA subas .env a Git.

# --- General ---
# 1 = modo desarrollo (en tu ordenador). En producción déjalo en 0.
DJANGO_DEBUG=1
# Cadena larga y aleatoria. Genérala con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria

# Producción: dominios permitidos y orígenes HTTPS de confianza
# ALLOWED_HOSTS=tudominio.es,www.tudominio.es
# CSRF_TRUSTED_ORIGINS=https://tudominio.es,https://www.tudominio.es
# TRUST_PROXY=1
# FORCE_HTTPS=1

# --- Base de datos MySQL (la que creas con MySQL Workbench) ---
DB_NAME=magia
DB_USER=root
DB_PASSWORD=tu_contraseña_de_mysql
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Gmail (para que los mensajes del formulario de contacto lleguen a tu correo) ---
# Tu cuenta de Gmail y una "contraseña de aplicación" de 16 letras (ver README)
GMAIL_USER=tucorreo@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# Dónde llegan los mensajes (puede ser el mismo Gmail)
NOTIFY_EMAIL=tucorreo@gmail.com
